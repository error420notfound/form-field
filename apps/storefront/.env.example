# Server-only URL for the public Payload REST API. No admin credentials.
CMS_URL=http://localhost:3000

# Public Store API configuration only. Never put admin or database credentials here.
PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace-with-publishable-store-api-key
# Server-side India/INR region selected during commerce setup.
MEDUSA_REGION_ID=replace-with-region-id
