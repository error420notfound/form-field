---
import Layout from '../../layouts/Layout.astro'
import AddToCart from '../../components/AddToCart.astro'
import ProductCard from '../../components/ProductCard.astro'
import Gallery from '../../components/interactive/Gallery'
import PourFrameStory from '../../components/PourFrameStory.astro'
import HomeViewStory from '../../components/HomeViewStory.astro'
import AppleDemoStory from '../../components/AppleDemoStory.astro'
import { isLocalAppleDemo } from '../../../../cms/src/local-apple-demo'
import PdpSections from '../../components/PdpSections.astro'
import {
  isPreview,
  product,
  media,
  mediaURL,
  price,
  availability,
  stock,
  type Product,
} from '../../lib/cms'
import { art, descriptor } from '../../lib/catalogue'
let p: Product | undefined,
  related: Product[] = [],
  error = ''
try {
  p = isLocalAppleDemo(Astro.params.slug!) && !import.meta.env.DEV ? undefined : await product(Astro.params.slug!, Astro.request)
  if (p)
    related = (p.relatedObjects || [])
      .filter(
        (item): item is Product =>
          typeof item === 'object' &&
          item.id !== p!.id &&
          item._status === 'published',
      )
      .slice(0, 2)
} catch {
  error =
    'The object’s story is temporarily unavailable. Please try again shortly.'
}
if (isPreview(Astro.request)) { Astro.response.headers.set('Cache-Control', 'private, no-store'); Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow') }
if (!p) Astro.response.status = error ? (isPreview(Astro.request) ? 403 : 503) : 404
const canConfigure = !isPreview(Astro.request) && !!p && !p.reviewOnly && p.purchaseEligible !== false && p.availability === 'available'
const reviewImage = p && art(p)
const inventory = p ? await stock(p.id) : null
const images = p
  ? reviewImage
    ? [
        {
          src: reviewImage,
          alt: `Illustrative concept for ${p.name}; not an actual product design`,
          placeholder: true,
        },
      ]
    : (p.gallery || [])
        .map(media)
        .filter((m) => m !== null)
        .map((m) => ({
          src: mediaURL(m.sizes?.gallery?.url || m.url),
          alt: m.alt,
          placeholder: !!m.placeholder,
        }))
  : []
const chapters = p?.story || []
const facts = p
  ? [
      ['Materials', p.materials],
      ['Dimensions', p.dimensions],
      ['Care', p.care],
      ['What’s included', p.included],
    ].filter(([, v]) => v)
  : []
---

<Layout title={p?.name || 'Object unavailable'} theme={p?.themeId}>
  {p && p.slug === 'homeview-review' && import.meta.env.DEV ? (
    <HomeViewStory product={p} />
  ) : p && isLocalAppleDemo(p.slug) && import.meta.env.DEV ? (
    <AppleDemoStory product={p} />
  ) : p && p.slug === 'pourframe-review' && p.reviewOnly ? (
    <PourFrameStory product={p} images={images} related={related} inventory={inventory} />
  ) : p ? (
    <>
      <nav class="product-bar" aria-label={`${p.name} story navigation`}>
        <a href="#overview">{p.name}</a>
        <div>
          <a href="#details" class="product-detail-link">
            Details
          </a>
          <a href="#practical" class="product-detail-link">
            Practical information
          </a>
          <a class="text-link" href="#purchase">
            {canConfigure ? 'Choose options' : 'Availability'}
          </a>
        </div>
      </nav>
      <section class="product-intro section" id="overview">
        <div class="story-title">
          <h1>
            {p.name}
            <span class="brand-dot" aria-hidden="true">
              .
            </span>
          </h1>
          <p class="lead">
            {descriptor(p)}
            {p.reviewOnly && ' · Draft concept'}
          </p>
        </div>
        <div class="story-hero">
          <div class="story-hero-copy">
            <p>{p.shortDescription}</p>
            {p.reviewOnly ? (
              <p class="draft-note">
                An illustrative concept for local review. The pictured object
                does not represent a confirmed form+field design.
              </p>
            ) : (
              <>
                <p>
                  {typeof p.price === 'number'
                    ? `Linked configuration: ${price(p.price)}`
                    : 'Price to be confirmed'}{' '}
                  · {availability(p.availability)}
                </p>
                {p.demo && (
                  <p class="draft-note">Fictional demonstration product.</p>
                )}
              </>
            )}
            <a class="text-link" href="#purchase">
              {canConfigure ? 'Choose options' : 'View availability'}
            </a>
          </div>
          <Gallery images={images} name={p.name} client:load />
        </div>
      </section>
      <div id="details">
        {p.pdpSections?.length ? (
          <PdpSections sections={p.pdpSections} />
        ) : chapters.length ? (
          chapters.map((chapter, i) => {
            const m = media(chapter.media)
            return (
              <section
                class:list={[
                  'editorial-section',
                  'story-chapter',
                  { 'story-chapter--reverse': i % 2 !== 0 },
                ]}
                id={`chapter-${chapter.chapterId}`}
              >
                <h2>{chapter.heading}</h2>
                <div>
                  <p>{chapter.copy}</p>
                  {m && (
                    <figure>
                      <img
                        src={mediaURL(m.sizes?.gallery?.url || m.url)}
                        alt={m.alt}
                        width="1200"
                        height="800"
                        loading="lazy"
                      />
                      {m.placeholder && (
                        <figcaption>Illustrative placeholder</figcaption>
                      )}
                    </figure>
                  )}
                </div>
              </section>
            )
          })
        ) : (
          <section class="editorial-section">
            <h2>A closer look.</h2>
            <div>
              <p class="prose">{p.description}</p>
              {p.features?.map((f) => (
                <section class="detail-note">
                  <h3>{f.title}</h3>
                  <p>{f.description}</p>
                </section>
              ))}
            </div>
          </section>
        )}
      </div>
      <section class="practical-section section" id="practical">
        <h2>Practical information.</h2>
        {facts.length ? (
          <dl class="specifications">
            {facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <div>
            <h3>Details to be confirmed.</h3>
            <p>
              Specifications, materials, included items and care information
              have not yet been supplied.
            </p>
          </div>
        )}
      </section>
      <section class="purchase-section section" id="purchase">
        <div>
          <p class="section-label">
            {canConfigure ? 'Your selection' : 'Availability'}
          </p>
          <h2>{canConfigure ? p.name : 'Not available to purchase.'}</h2>
          <p>
            {typeof p.price === 'number'
              ? `Linked configuration: ${price(p.price)}`
              : 'Price to be confirmed.'}
          </p>
          {p.reviewOnly && (
            <p>
              Product specifications and availability are not yet confirmed.
            </p>
          )}
          {inventory && !('error' in inventory) && inventory.linked && (
            <p>{inventory.available ? 'In stock in Odoo' : 'Out of stock'}</p>
          )}
        </div>
        <div>
          {!isPreview(Astro.request) && <AddToCart product={p} />}
          <p class="muted">
            {canConfigure
              ? 'Local demo orders do not collect payment.'
              : 'This concept cannot be added to your bag.'}
          </p>
          <a class="text-link" href="/support">
            Delivery and returns information
          </a>
        </div>
      </section>
      {related.length > 0 && (
        <section class="section related-section">
          <div class="section-heading">
            <h2>Another familiar desire.</h2>
            <a class="text-link" href="/shop">
              All objects
            </a>
          </div>
          <div class="related-grid">
            {related.map((item) => (
              <ProductCard product={item} headingLevel={3} />
            ))}
          </div>
        </section>
      )}
    </>
  ) : (
    <section class="section error-state">
      <h1>{error ? 'A moment, please.' : 'Object not found.'}</h1>
      <p role={error ? 'alert' : undefined}>
        {error || 'This object may have been removed or is not published.'}
      </p>
      <a class="text-link" href="/shop">
        Back to Objects
      </a>
    </section>
  )}
</Layout>
