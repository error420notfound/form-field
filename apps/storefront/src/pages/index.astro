---
import Layout from '../layouts/Layout.astro'
import ObjectFeature from '../components/ObjectFeature.astro'
import { catalogue } from '../lib/catalogue'
import { websitePage, isPreview, type Product } from '../lib/cms'
import WebsiteSections from '../components/WebsiteSections.astro'
let website = null
try { website = await websitePage('home', Astro.request) } catch { if (isPreview(Astro.request)) Astro.response.status = 403 }
let items: Product[] = [],
  error = ''
try {
  items = await catalogue()
} catch {
  error = 'The catalogue is temporarily unavailable. Please try again shortly.'
}
if (error) Astro.response.status = 503
const publicItems = items.filter((p) => p.reviewOnly || !p.demo)
const sequence = publicItems.length ? publicItems : items
const broad = sequence.some((p) => p.homepageSize === 'broad')
  ? sequence.filter((p) => p.homepageSize === 'broad')
  : sequence.slice(0, 2)
const remaining = sequence.filter((p) => !broad.includes(p))
const finalCount = remaining.length ? (remaining.length % 2 || Math.min(2, remaining.length)) : 0
const paired = remaining.slice(0, remaining.length - finalCount)
const closing = remaining.slice(remaining.length - finalCount)
---

<Layout title="Objects shaped by familiar desires">
  {website?.sections?.length ? (
    <WebsiteSections sections={website.sections}>
      <div slot="catalogue" class="catalogue-features">
        {broad.map((p, i) => <ObjectFeature product={p} lead={i === 0} />)}
        <div class="paired-features">{paired.map((p) => <ObjectFeature product={p} compact />)}</div>
        {closing.map((p) => <ObjectFeature product={p} />)}
      </div>
    </WebsiteSections>
  ) : <>
  {error ? (
    <section class="section error-state">
      <h1>Objects, in a moment.</h1>
      <p role="alert">{error}</p>
      <a class="button" href="/">
        Try again
      </a>
    </section>
  ) : sequence.length ? (
    <>
      <div class="catalogue-features">
        {broad.map((p, i) => (
          <ObjectFeature product={p} lead={i === 0} />
        ))}
        <div class="paired-features">
          {paired.map((p) => (
            <ObjectFeature product={p} compact />
          ))}
        </div>
        {closing.map((p) => (
          <ObjectFeature product={p} />
        ))}
      </div>
    </>
  ) : (
    <section class="section">
      <h1>The collection is taking shape.</h1>
      <p>Objects will appear here when their stories are ready.</p>
    </section>
  )}
  <section class="brand-note" id="approach">
    <h2>
      Objects shaped
      <br />
      by familiar desires
      <span class="brand-dot" aria-hidden="true">
        .
      </span>
    </h2>
    <div>
      <p>
        A small irritation. A familiar gesture. A possibility that feels
        overdue. These are places to begin.
      </p>
      <a class="text-link" href="/about">
        About form+field
      </a>
    </div>
  </section>
  </>}
</Layout>
