---
import Layout from '../layouts/Layout.astro'
import WebsiteSections from '../components/WebsiteSections.astro'
import { websitePage, isPreview } from '../lib/cms'
let website = null
try { website = await websitePage('about', Astro.request) } catch { if (isPreview(Astro.request)) Astro.response.status = 403 }
---

<Layout title="About">
  {website?.sections?.length ? <WebsiteSections sections={website.sections} /> : <>
  <section class="section about-intro">
    <h1>
      Familiar desires.
      <br />
      Made tangible
      <span class="brand-dot" aria-hidden="true">
        .
      </span>
    </h1>
    <p class="lead">
      form+field is an evolving collection of physical and electronic objects.
    </p>
  </section>
  <section class="editorial-section">
    <p class="section-label">A place to begin</p>
    <div>
      <h2>Notice the ordinary.</h2>
      <p>
        A small irritation resolved. An interaction made more natural. A
        capability that feels overdue. An object begins with something already
        familiar.
      </p>
      <p>
        The collection brings together lighting, desk objects and tools. Their
        relationship comes from the care of the decisions behind them.
      </p>
    </div>
  </section>
  <section class="editorial-section">
    <p class="section-label">The collection today</p>
    <div>
      <h2>Room to understand.</h2>
      <p>
        This local storefront explores how each object can be presented through
        its story. Product concepts, imagery and unconfirmed details are
        labelled for review.
      </p>
      <a class="text-link" href="/shop">
        Explore the objects
      </a>
    </div>
  </section>
  </>}
</Layout>
