---
import Layout from '../layouts/Layout.astro'
import BagView from '../components/interactive/BagView'
import UpsellRecommendations from '../components/interactive/UpsellRecommendations'
---

<Layout title="Your bag">
  <section class="section cart-page">
    <div class="page-heading">
      <h1>
        Your bag
        <span class="brand-dot" aria-hidden="true">
          .
        </span>
      </h1>
      <p>A place to gather the objects you’re considering.</p>
    </div>
    <BagView client:load />
    <noscript>
      Enable JavaScript to view your locally saved bag.{' '}
      <a href="/shop">Browse objects</a>.
    </noscript>
  </section>
  <UpsellRecommendations client:load />
</Layout>
