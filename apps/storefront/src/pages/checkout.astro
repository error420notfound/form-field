---
import Layout from '../layouts/Layout.astro'
import CheckoutPreview from '../components/interactive/CheckoutPreview'
import BagView from '../components/interactive/BagView'
---

<Layout title="Demo checkout">
  <section class="section checkout-page">
    <div class="page-heading">
      <h1>
        Demo checkout
        <span class="brand-dot" aria-hidden="true">
          .
        </span>
      </h1>
      <p class="notice">
        Local demonstration. This creates an Odoo order without taking payment.
        Commerce bag selections use a separate flow and are not included here.
      </p>
    </div>
    <div class="checkout-layout">
      <div>
        <h2>Delivery details</h2>
        <p class="muted">
          These details are saved with the demo order in Payload and Odoo.
        </p>
        <CheckoutPreview client:load />
      </div>
      <section aria-label="Your selections">
        <h2>Your selections</h2>
        <BagView preview client:load />
      </section>
    </div>
  </section>
</Layout>
