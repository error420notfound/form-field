---
import Layout from '../layouts/Layout.astro'
import CheckoutPreview from '../components/interactive/CheckoutPreview'
import BagView from '../components/interactive/BagView'
---

<Layout title="Checkout preview">
  <section class="section checkout-page">
    <div class="page-heading">
      <h1>
        Checkout preview
        <span class="brand-dot" aria-hidden="true">
          .
        </span>
      </h1>
      <p class="notice">
        Local demonstration. No payment or order is submitted.
      </p>
    </div>
    <div class="checkout-layout">
      <div>
        <h2>Delivery address preview</h2>
        <p class="muted">
          For layout review only. Address information is not submitted or saved.
        </p>
        <CheckoutPreview client:load />
      </div>
      <section aria-label="Your selections">
        <h2>Your selections</h2>
        <BagView preview client:load />
      </section>
    </div>
  </section>
</Layout>
