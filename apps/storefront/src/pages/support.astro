---
import Layout from '../layouts/Layout.astro'
import SupportDetails from '../components/interactive/SupportDetails'
import { settings } from '../lib/cms'
let email: string | null | undefined
try {
  email = (await settings()).contactEmail
} catch {}
---

<Layout title="Support">
  <section class="section support-page">
    <div class="page-heading">
      <h1>
        A little guidance
        <span class="brand-dot" aria-hidden="true">
          .
        </span>
      </h1>
      <p>Practical information, as the collection takes shape.</p>
    </div>
    <div class="support-layout">
      <div>
        <h2>Here to help.</h2>
        <p>
          This is a local review storefront. Product guides and policies will
          appear here when confirmed.
        </p>
        {email && !email.endsWith('.test') && (
          <a class="text-link" href={`mailto:${email}`}>
            {email}
          </a>
        )}
      </div>
      <SupportDetails client:load />
    </div>
  </section>
</Layout>
