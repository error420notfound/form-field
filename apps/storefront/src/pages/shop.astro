---
import Layout from '../layouts/Layout.astro'
import ProductCard from '../components/ProductCard.astro'
import { catalogue } from '../lib/catalogue'
import type { Product } from '../lib/cms'
let items: Product[] = [],
  error = ''
try {
  items = await catalogue()
} catch {
  error = 'The catalogue is temporarily unavailable. Please try again shortly.'
}
if (error) Astro.response.status = 503
---

<Layout title="Objects">
  <section class="section">
    <div class="page-heading">
      <h1>
        Objects
        <span class="brand-dot" aria-hidden="true">
          .
        </span>
      </h1>
      <p>An evolving catalogue. Each object has a story.</p>
    </div>
    {error ? (
      <p class="notice" role="alert">
        {error} <a href="/shop">Try again</a>
      </p>
    ) : items.length ? (
      <div class="product-grid">
        {items.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    ) : (
      <p>The collection is taking shape.</p>
    )}
  </section>
</Layout>
