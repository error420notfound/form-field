---
import { isDigitalAppleDemo, isLocalAppleDemo } from '../../../cms/src/local-apple-demo'
import { image, media, homepageMediaURL, type Product } from '../lib/cms'
import { art, descriptor, canPurchase } from '../lib/catalogue'
const {
  product: p,
  lead = false,
  compact = false,
} = Astro.props as { product: Product; lead?: boolean; compact?: boolean }
const sourceMedia = media(p.gallery?.[0])
const src = art(p, !compact) || homepageMediaURL(sourceMedia?.sizes?.gallery?.url || sourceMedia?.url)
const imageAlt = p.reviewOnly && !isLocalAppleDemo(p.slug) ? `Illustrative concept for ${p.name}; not an actual product design` : image(p).alt
const Heading = lead ? 'h1' : 'h2'
const placement = compact ? p.homepageTextPlacement || 'above' : 'above'
const status = isDigitalAppleDemo(p.slug) ? 'Digital experience · Local Apple demonstration' : isLocalAppleDemo(p.slug) ? 'Local Apple demonstration' : p.reviewOnly ? 'Draft concept' : ''
const crop = {
  '--media-x': (sourceMedia?.focalX ?? 50) + '%',
  '--media-y': (sourceMedia?.focalY ?? 50) + '%',
  '--mobile-media-x':
    (sourceMedia?.mobileFocalX ?? sourceMedia?.focalX ?? 50) + '%',
  '--mobile-media-y':
    (sourceMedia?.mobileFocalY ?? sourceMedia?.focalY ?? 50) + '%',
}
---

<article
  style={crop}
  class:list={[
    'object-feature',
    `object-feature--${placement}`,
    { 'object-feature--lead': lead, 'object-feature--compact': compact },
  ]}
>
  {src && (
    <picture class="feature-art">
      {art(p) && !compact && (
        <source
          media="(max-width:767px)"
          type="image/webp"
          srcset={art(p)!.replace('.webp', '-640.webp')}
        />
      )}
      {art(p) && (
        <source
          type="image/webp"
          srcset={`${src.replace('.webp', '-640.webp')} 640w, ${src} 1536w`}
          sizes={compact ? '(min-width: 768px) 50vw, 100vw' : '100vw'}
        />
      )}
      <img
        src={src}
        alt={imageAlt}
        width="1536"
        height="1024"
        loading={lead ? 'eager' : 'lazy'}
        fetchpriority={lead ? 'high' : 'auto'}
      />
    </picture>
  )}
  <div class="feature-fallback" hidden={!!src}>Image unavailable · {imageAlt}</div>
  <div class="feature-heading">
    <Heading>
        {p.name}
        <span class="brand-dot" aria-hidden="true">
          .
        </span>
    </Heading>
  </div>
  <div class="feature-copy">
    <p>
      {descriptor(p)}
    </p>
    {status && <p class="feature-status">{status}</p>}
    <div class="feature-actions">
      <a class="story-link" href={`/products/${p.slug}`} aria-label={`Explore ${p.name}`}>Explore</a>
      {canPurchase(p) && <a class="story-link story-link--buy" href={`/products/${p.slug}/configure`} aria-label={`Buy ${p.name}`}>Buy</a>}
    </div>
  </div>
  {p.reviewOnly && !isLocalAppleDemo(p.slug) && (
    <span class="placeholder-label">Illustrative placeholder</span>
  )}
</article>

<script>
  const showFallback = (img: HTMLImageElement) => {
    const picture = img.closest('picture')
    const fallback = picture?.parentElement?.querySelector<HTMLElement>('.feature-fallback')
    if (picture && fallback) { picture.hidden = true; fallback.hidden = false }
  }
  document.querySelectorAll<HTMLImageElement>('.object-feature .feature-art img').forEach(img => {
    if (img.complete && img.naturalWidth === 0) showFallback(img)
    else img.addEventListener('error', () => showFallback(img), { once: true })
  })
</script>
