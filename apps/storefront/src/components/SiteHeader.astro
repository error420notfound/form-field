---
import HeaderActions from './interactive/HeaderActions'
const path = Astro.url.pathname
---

<header class="site-header">
  <a class="wordmark" href="/" translate="no" aria-label="form+field home">
    form+field
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    <a href="/shop" aria-current={path === '/shop' ? 'page' : undefined}>
      Objects
    </a>
    <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>
      About
    </a>
    <a href="/support" aria-current={path === '/support' ? 'page' : undefined}>
      Support
    </a>
  </nav>
  <HeaderActions client:load />
  <noscript>
    <a href="/shop">Objects</a> <a href="/cart">Bag</a>
  </noscript>
</header>
