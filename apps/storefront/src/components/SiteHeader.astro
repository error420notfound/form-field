---
import HeaderActions from './interactive/HeaderActions'
const path = Astro.url.pathname
const links = Astro.props.links?.length ? Astro.props.links : [{url:'/shop',label:'Objects'},{url:'/about',label:'About'},{url:'/support',label:'Support'}]
---

<header class="site-header">
  <a class="wordmark" href="/" translate="no" aria-label="form+field home">
    form+field
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map((link: {url:string;label:string}) => <a href={link.url} aria-current={path === link.url ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <HeaderActions links={links} client:load />
  <noscript>
    <a href="/shop">Objects</a> <a href="/cart">Bag</a>
  </noscript>
</header>
