---
import { isDigitalAppleDemo, isLocalAppleDemo } from '../../../cms/src/local-apple-demo'
import { image, media, price, availability, type Product } from '../lib/cms'
import { art, descriptor } from '../lib/catalogue'
const { product: p } = Astro.props as { product: Product }
const img = image(p),
  src = art(p) || img.url
const Heading = Astro.props.headingLevel === 3 ? 'h3' : 'h2'
const sourceMedia = media(p.gallery?.[0])
const crop = {
  '--media-x': (sourceMedia?.focalX ?? 50) + '%',
  '--media-y': (sourceMedia?.focalY ?? 50) + '%',
  '--mobile-media-x':
    (sourceMedia?.mobileFocalX ?? sourceMedia?.focalX ?? 50) + '%',
  '--mobile-media-y':
    (sourceMedia?.mobileFocalY ?? sourceMedia?.focalY ?? 50) + '%',
}
---

<article class="product-card" style={crop}>
  <a href={`/products/${p.slug}`} class="product-image">
    {src ? (
      <img
        src={src}
        alt={p.reviewOnly && !isLocalAppleDemo(p.slug) ? `Illustrative concept for ${p.name}` : img.alt}
        width="640"
        height="480"
        loading="lazy"
      />
    ) : (
      <span>Imagery to follow</span>
    )}
    {p.reviewOnly && !isLocalAppleDemo(p.slug) && (
      <span class="placeholder-label">Illustrative placeholder</span>
    )}
  </a>
  <div class="product-meta">
    <Heading>
      <a href={`/products/${p.slug}`}>{p.name}</a>
    </Heading>
    <span>
      {isLocalAppleDemo(p.slug) ? 'Local demonstration' : typeof p.price === 'number' ? price(p.price) : 'Price to be confirmed'}
    </span>
  </div>
  <p>{descriptor(p)}</p>
  <p class="muted">
    {isDigitalAppleDemo(p.slug) ? 'Digital experience · Apple reference · Not for sale' : isLocalAppleDemo(p.slug) ? 'Apple reference · Not for sale' : p.reviewOnly
      ? 'Draft concept · Not for sale'
      : `${availability(p.availability)}${p.demo ? ' · Fictional demo' : ''}`}
  </p>
</article>
