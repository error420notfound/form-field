---
const { email } = Astro.props
const realEmail = email && !email.endsWith('.test') ? email : null
---

<footer class="site-footer">
  <div class="footer-brand">
    <a class="wordmark" href="/" translate="no">
      form+field
    </a>
    <p class="credit">Designed by HS108 in India.</p>
  </div>
  <nav aria-label="Footer navigation">
    <a href="/shop">Objects</a>
    <a href="/about">About</a>
    <a href="/support">Support</a>
  </nav>
  <div class="footer-note">
    <a href="/cart">Your bag</a>
    {realEmail && <a href={`mailto:${realEmail}`}>Contact</a>}
    <p>Local review · Demo checkout</p>
  </div>
</footer>
