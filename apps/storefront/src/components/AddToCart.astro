---
const { product } = Astro.props
const eligible = !product.reviewOnly && product.purchaseEligible !== false && product.availability === 'available'
---
{eligible ? <a class="config-pdp-action" href={`/products/${product.slug}/configure`}>Choose options <span aria-hidden="true">↗</span></a> : <p class="availability-note">Not available to purchase.</p>}
