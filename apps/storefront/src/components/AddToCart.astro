---
import QuantityControl from './QuantityControl.astro'
const { product } = Astro.props
---

{product.availability === 'available' ? (
  <form data-add-to-cart data-id={product.id} class="add-form">
    <QuantityControl />
    <button class="button" type="submit">
      Add to cart <span aria-hidden="true">↗</span>
    </button>
    <p data-add-status role="status" class="muted"></p>
  </form>
) : (
  <p class="notice">
    This product is currently{' '}
    {product.availability === 'coming-soon' ? 'coming soon' : 'unavailable'}.
  </p>
)}
