---
import { settings, websitePage, isPreview } from '../lib/cms'
import { themeFor } from '../lib/catalogue'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import '../styles/global.css'
import themeManifest from '../data/themes.json'
import facultyFont from '@fontsource/faculty-glyphic/files/faculty-glyphic-latin-400-normal.woff2?url'
import geistFont from '@fontsource/geist/files/geist-latin-400-normal.woff2?url'
const { title, theme = 'neutral' } = Astro.props
let store
let navigation = null
try { navigation = await websitePage('navigation', Astro.request) } catch {}
if (isPreview(Astro.request)) { Astro.response.headers.set('Cache-Control', 'private, no-store'); Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow') }
const links = navigation?.sections?.filter((s) => s.kind === 'link' && s.linkText && s.linkUrl).map((s) => ({label:s.linkText!, url:s.linkUrl!}))
try {
  store = await settings()
} catch {
  /* Page-level content reports CMS failures. */
}
const rootTheme = themeFor(theme)
---

<!doctype html>
<html lang="en" data-theme={rootTheme}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="theme-color" content={themeManifest.themes[rootTheme].canvas} />
    <link
      rel="preload"
      href={facultyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content="form+field. An evolving catalogue of objects shaped by familiar desires."
    />
    <title>{title} · form+field</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    {isPreview(Astro.request) && <div role="status" style="padding:.65rem 1rem;text-align:center;background:#e8dfc9;color:#242018;font-size:.85rem">Draft preview · Sign in to Payload on this hostname to view unpublished content.</div>}
    <SiteHeader links={links} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter email={store?.contactEmail} links={links} />
    <script>
      const measure = () => {
        const header = document.querySelector('.site-header')
        const bar = document.querySelector('.product-bar')
        document.documentElement.style.setProperty(
          '--header-height',
          (header?.getBoundingClientRect().height || 64) + 'px',
        )
        document.documentElement.style.setProperty(
          '--product-bar-height',
          (bar?.getBoundingClientRect().height || 0) + 'px',
        )
      }
      const observer = new ResizeObserver(measure)
      document
        .querySelectorAll('.site-header,.product-bar')
        .forEach((node) => observer.observe(node))
      measure()
      window.addEventListener('pagehide', () => observer.disconnect(), {
        once: true,
      })
      window.addEventListener('pageshow', () => {
        document
          .querySelectorAll('.site-header,.product-bar')
          .forEach((node) => observer.observe(node))
        measure()
      })
    </script>
  </body>
</html>
