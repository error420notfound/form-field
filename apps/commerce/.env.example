# Local development. Use a dedicated PostgreSQL database, never the Payload DB.
DATABASE_URL=postgres://formfield_medusa:replace-with-local-password@127.0.0.1:5433/formfield_medusa
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:4321
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:4321,http://localhost:9000
JWT_SECRET=replace-with-secure-random-secret
COOKIE_SECRET=replace-with-secure-random-secret
# Default single-process development modules use in-memory state. Redis is not required.
