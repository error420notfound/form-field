{
  "name": "@form-field/commerce",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "node ../../scripts/commerce-cli.mjs build",
    "start": "node ../../scripts/commerce-cli.mjs start -H localhost -p 9000",
    "dev": "node ../../scripts/commerce-cli.mjs develop -H localhost -p 9000",
    "lint": "node ../../scripts/commerce-cli.mjs lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "check": "tsc --noEmit",
    "migrate": "node ../../scripts/commerce-cli.mjs db:migrate",
    "migrate:create": "node ../../scripts/commerce-cli.mjs db:generate",
    "setup:store": "node ../../scripts/commerce-cli.mjs exec ./src/scripts/setup-store.ts",
    "seed:fixture": "node ../../scripts/commerce-cli.mjs exec ./src/scripts/fixture.ts",
    "cli": "node ../../scripts/commerce-cli.mjs"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/admin-shared": "2.22.1",
    "@medusajs/caching": "2.22.1",
    "@medusajs/cli": "2.22.1",
    "@medusajs/dashboard": "2.22.1",
    "@medusajs/draft-order": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@medusajs/ui": "4.2.8",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "@medusajs/eslint-plugin": "2.22.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "private": true
}
